# Copy to .env in this directory. Existing shell variables override these values.
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key
# Optional: customize to your Google AI Studio quota (milliseconds per code chunk).
GEMINI_EMBEDDING_BATCH_SIZE=16
GEMINI_EMBEDDING_DELAY_MS=750
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
# Use a long random password and a hexadecimal salt (at least 8 bytes).
TOKEN_ENCRYPTOR_PASSWORD=replace-with-a-long-random-password
TOKEN_ENCRYPTOR_SALT=deadbeefcafebabe

# Defaults match docker-compose.yaml; change these for an external database.
DB_URL=jdbc:postgresql://localhost:5433/devpilot
DB_USERNAME=postgres
DB_PASSWORD=postgres
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
